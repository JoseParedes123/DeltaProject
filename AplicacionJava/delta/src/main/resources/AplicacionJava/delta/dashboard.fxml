<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox minHeight="600.0" minWidth="900.0" spacing="20.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AplicacionJava.delta.dashboardController">
    <children>
      <HBox alignment="CENTER" maxHeight="128.0" minHeight="128.0" spacing="10.0" styleClass="header">
         <children>
            <GridPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
              <columnConstraints>
                <ColumnConstraints halignment="LEFT" hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" />
                <ColumnConstraints halignment="LEFT" maxWidth="1.7976931348623157E308" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                    <Button fx:id="secondaryButton" onAction="#cerrarSesion" styleClass="logout" text="Cerrar Sesión" GridPane.columnIndex="1">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Button>
                    <Label alignment="TOP_LEFT" contentDisplay="BOTTOM" styleClass="header" text="Gestión de Logísticas Delta">
                     <font>
                        <Font name="Arial Rounded MT Bold" size="24.0" />
                     </font>
                     <padding>
                        <Insets top="20.0" />
                     </padding>
                  </Label>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </GridPane>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </HBox>
      <ToolBar prefHeight="40.0">
        <items>
            <TextField maxWidth="1.7976931348623157E308" />
            <ComboBox prefWidth="150.0" />
            <Button mnemonicParsing="false" styleClass="boton" text="Buscar">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
            <Button mnemonicParsing="false" text="Ver Historial" />
        </items>
      </ToolBar>
      <HBox>
         <children>
            <TableView maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="codigo" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="75.0" text="Código" />
                <TableColumn fx:id="descripcion" prefWidth="75.0" text="Descripción" />
                  <TableColumn fx:id="mercaderia" maxWidth="1.7976931348623157E308" prefWidth="75.0" text="Mercadería" />
                  <TableColumn fx:id="peso" maxWidth="1.7976931348623157E308" prefWidth="75.0" text="Peso(Kg)" />
                  <TableColumn fx:id="estado" maxWidth="1.7976931348623157E308" prefWidth="75.0" text="Estado" />
                  <TableColumn fx:id="ubicacion" maxWidth="1.7976931348623157E308" prefWidth="75.0" text="Ubicación" />
              </columns>
            </TableView>
         </children>
      </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
