package AplicacionJava.delta.DAO;

import AplicacionJava.delta.modulos.usuario;
import java.sql.*;

public class usuarioDAO {

	private usuario autenticar(String _usuario, String _contrasena) throws SQLException {
		String peticion =
				"SELECT id_usuario,nombre,apellido,nombre_usuario,rol FROM usuarios"
				+ "WHERE nombre_usuario = ? AND password_hash=SHA2(?,256) AND activo=1";

        try (Connection conexionBD= conexion.obtenerConexion();
                PreparedStatement sentencia=conexionBD.prepareStatement(peticion)) {
               sentencia.setString(1, _usuario);
               sentencia.setString(2, _contrasena);
               try (ResultSet resultado=sentencia.executeQuery()) {
                   if (!resultado.next()) return null;
usuario usuario=new usuario();
usuario.setId(resultado.getInt("id_usuario"));
usuario.setNombre(resultado.getString("nombre"));
usuario.setApellido(resultado.getString("apellido"));
usuario.setNombreUsuario(resultado.getString("nombre_usuario"));
usuario.setRol(resultado.getString("rol"));
return usuario;
               }
           }
       }
}
