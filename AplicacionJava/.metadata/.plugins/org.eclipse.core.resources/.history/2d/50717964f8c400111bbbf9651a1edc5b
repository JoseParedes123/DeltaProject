package AplicacionJava.delta.DAO;

import AplicacionJava.delta.modulos.usuario;
import java.sql.*;

public class usuarioDAO {

	public usuario autenticar(String _usuario, String _contrasena) throws SQLException {
		usuario usuario = null;
		String peticion =
				"SELECT id_usuario,nombre,apellido,nombre_usuario,rol FROM usuarios"
				+ "WHERE nombre_usuario = ? AND password_hash=SHA2(?,256) AND activo=1";

        try (
        		Connection conexionBD= conexion.obtenerConexion();
        		PreparedStatement peticionBD = conexionBD.prepareStatement(peticion)
        		){
        	
        	peticionBD.setString(1, _usuario);
        	peticionBD.setString(2, _contrasena);
        	ResultSet resultado = peticionBD.executeQuery();
        	
        	if(resultado.next()) {
        		usuario = new usuario();
        		usuario.setId(resultado.getInt("id_usuario"));
        		usuario.setId(resultado.getInt("nombre"));
        		usuario.setId(resultado.getInt("apellido"));
        		usuario.setId(resultado.getInt("nombre_usuario"));
        		usuario.setId(resultado.getInt("rol"));
        	}
        }catch(Exception e){
        	System.out.println("Error: " + e);
        }
        return usuario;
	}
}
