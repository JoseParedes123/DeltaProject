package AplicacionJava.delta;
import java.io.IOException;
import AplicacionJava.delta.modulos.usuario;
import AplicacionJava.delta.modulos.paquete;
import javafx.fxml.FXML;
import javafx.scene.control.TableView;
import javafx.scene.control.TableColumn;
import javafx.collections.ObservableList;
import java.net.URL;
import java.util.ResourceBundle;

public class dashboardController{
	@FXML private static usuario usuarioActual;
	@FXML private TableColumn<paquete,String> codigo, descripcion, tipo, estado, ubicacion;
	
    @FXML private void cerrarSesion() throws IOException {//para salir
    	usuarioActual = null;
        App.setRoot("login");
    }
    @FXML private void usuarioActual(usuario _usuario) {
    	usuarioActual = _usuario;
    }
    @FXML public void initialize() {
        codigo.setCellValueFactory(new PropertyValueFactory<>("codigo"));
        descripcion.setCellValueFactory(new PropertyValueFactory<>("descripcion"));
        estado.setCellValueFactory(new PropertyValueFactory<>("estado"));
        ubicacion.setCellValueFactory(new PropertyValueFactory<>("ubicacion"));
        tipo.setCellValueFactory(new PropertyValueFactory<>("tipoMercaderia"));
    }

    
}

