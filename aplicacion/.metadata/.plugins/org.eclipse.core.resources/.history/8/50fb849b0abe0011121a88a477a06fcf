<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="JavaApp.delta.HomeController">
   <children>
      <Label text="Delta">
         <font>
            <Font name="Monospaced Italic" size="24.0" />
         </font></Label>
      <Button fx:id="BotonLogin" onAction="#lol" prefHeight="26.0" prefWidth="65.0" text="Login" />
      <Button fx:id="BotonSalir" onAction="#Cerrar" text="Salir" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
