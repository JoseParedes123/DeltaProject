<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane stylesheets="@style.css" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="JavaApp.delta.DashboardController">
  <top>
    <VBox spacing="5" styleClass="header">
      <padding><Insets top="18" right="22" bottom="18" left="22"/></padding>
      <HBox alignment="CENTER_LEFT" spacing="15">
        <VBox HBox.hgrow="ALWAYS">
          <Label text="GESTIÓN DE LOGÍSTICA DELTA" styleClass="header-title"/>
          <HBox spacing="15"><Label fx:id="bienvenida" styleClass="header-subtitle"/><Label fx:id="etiquetaRol" styleClass="header-subtitle"/></HBox>
        </VBox>
        <Button text="Cerrar sesión" onAction="#cerrarSesion"/>
      </HBox>
    </VBox>
  </top>
  <center>
    <VBox spacing="12">
      <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
      <HBox spacing="10">
        <TextField fx:id="busqueda" promptText="Buscar por código, descripción o mercadería..." HBox.hgrow="ALWAYS" onAction="#buscar"/>
        <ComboBox fx:id="filtroEstado" prefWidth="190"/>
        <Button text="Buscar" onAction="#buscar" styleClass="primary-button"/>
        <Button text="Ver historial" onAction="#verHistorial"/>
      </HBox>
      <Label fx:id="detalle" text="Seleccioná un paquete para ver sus detalles." styleClass="muted"/>
      <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="columnaCodigo" text="Código" prefWidth="120"/>
          <TableColumn fx:id="columnaDescripcion" text="Descripción" prefWidth="220"/>
          <TableColumn fx:id="columnaMercaderia" text="Mercadería" prefWidth="140"/>
          <TableColumn fx:id="columnaPeso" text="Peso (kg)" prefWidth="90"/>
          <TableColumn fx:id="columnaEstado" text="Estado" prefWidth="145"/>
          <TableColumn fx:id="columnaUbicacion" text="Ubicación" prefWidth="190"/>
        </columns>
      </TableView>

      <TitledPane fx:id="panelOperaciones" text="Operaciones de depósito" expanded="true">
        <GridPane hgap="10" vgap="10">
          <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
          <Label text="Cambiar estado:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
          <ComboBox fx:id="nuevoEstado" prefWidth="210" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
          <Button text="Guardar estado" onAction="#guardarEstado" styleClass="primary-button" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
          <Label text="Mover a ubicación:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
          <ComboBox fx:id="ubicacion" prefWidth="300" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
          <Button text="Actualizar ubicaciones" onAction="#cargarUbicaciones" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
          <Label text="Motivo:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
          <TextField fx:id="motivo" promptText="Ej.: recepción, clasificación, preparación..." GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="2"/>
          <Button text="Registrar movimiento" onAction="#moverPaquete" styleClass="primary-button" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        </GridPane>
      </TitledPane>

      <TitledPane fx:id="panelReparto" text="Operaciones de chofer" expanded="false">
        <GridPane hgap="10" vgap="10">
          <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
          <Label text="Estado de entrega:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
          <ComboBox fx:id="estadoReparto" prefWidth="210" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
          <Button text="Actualizar entrega" onAction="#actualizarEntrega" styleClass="primary-button" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
          <Label text="Tipo de incidencia:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
          <ComboBox fx:id="tipoIncidencia" prefWidth="210" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
          <TextArea fx:id="incidenciaTexto"
          promptText="Descripción del incidente..."
          prefRowCount="3"
          wrapText="true"
          GridPane.rowIndex="2"
          GridPane.columnIndex="0"
          GridPane.columnSpan="2"/>
          <Button text="Registrar incidencia" onAction="#registrarIncidencia" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
        </GridPane>
      </TitledPane>

      <TitledPane fx:id="panelAdministracion" text="Administración y control" expanded="false" onMouseClicked="#cargarResumen">
        <VBox spacing="10">
          <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
          <Label text="Resumen operativo" styleClass="section-title"/>
          <Label fx:id="resumen" text="Presioná sobre esta sección para cargar el resumen." wrapText="true"/>
          <Label text="Los permisos se aplican automáticamente según el rol del usuario. Los clientes y choferes solo visualizan los envíos que les corresponden." styleClass="muted" wrapText="true"/>
        </VBox>
      </TitledPane>
    </VBox>
  </center>
</BorderPane>
