<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="JavaApp.delta.DashboardController">

    <top>
        <VBox spacing="5" styleClass="header">
            <padding>
                <Insets top="18" right="22" bottom="18" left="22"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="15">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="GESTIÓN DE DEPÓSITO"
                           styleClass="header-title"/>
                    <Label fx:id="bienvenida"
                           styleClass="header-subtitle"/>
                </VBox>

                <Button text="Cerrar sesión"
                        onAction="#cerrarSesion"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="12">

            <padding>
                <Insets top="18" right="18" bottom="18" left="18"/>
            </padding>

            <HBox spacing="10">
                <TextField fx:id="busqueda"
                           promptText="Buscar por código, descripción o mercadería..."
                           HBox.hgrow="ALWAYS"
                           onAction="#buscar"/>

                <ComboBox fx:id="filtroEstado"
                          prefWidth="190"/>

                <Button text="Buscar"
                        onAction="#buscar"
                        styleClass="primary-button"/>
            </HBox>

            <Label fx:id="detalle"
                   text="Seleccioná un paquete para ver sus detalles."
                   styleClass="muted"/>

            <TableView fx:id="tabla"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colCodigo"
                                 text="Código"
                                 prefWidth="120"/>

                    <TableColumn fx:id="colDescripcion"
                                 text="Descripción"
                                 prefWidth="220"/>

                    <TableColumn fx:id="colTipo"
                                 text="Mercadería"
                                 prefWidth="140"/>

                    <TableColumn fx:id="colPeso"
                                 text="Peso (kg)"
                                 prefWidth="90"/>

                    <TableColumn fx:id="colEstado"
                                 text="Estado"
                                 prefWidth="145"/>

                    <TableColumn fx:id="colUbicacion"
                                 text="Ubicación"
                                 prefWidth="190"/>

                </columns>
            </TableView>

            <TitledPane text="Operaciones de depósito"
                        expanded="true">

                <GridPane hgap="10" vgap="10">


				    <!-- Cambiar estado -->
				    <Label text="Cambiar estado:"
				           GridPane.rowIndex="0"
				           GridPane.columnIndex="0"/>
				
				    <ComboBox fx:id="nuevoEstado"
				              prefWidth="210"
				              GridPane.rowIndex="0"
				              GridPane.columnIndex="1"/>
				
				    <Button text="Guardar estado"
				            onAction="#guardarEstado"
				            styleClass="primary-button"
				            GridPane.rowIndex="0"
				            GridPane.columnIndex="2"/>
				
				
				    <!-- Mover a ubicación -->
				    <Label text="Mover a ubicación:"
				           GridPane.rowIndex="1"
				           GridPane.columnIndex="0"/>
				
				    <ComboBox fx:id="ubicacion"
				              prefWidth="300"
				              GridPane.rowIndex="1"
				              GridPane.columnIndex="1"/>
				
				    <Button text="Actualizar ubicaciones"
				            onAction="#cargarUbicaciones"
				            GridPane.rowIndex="1"
				            GridPane.columnIndex="2"/>
				
				
				    <!-- Motivo -->
				    <Label text="Motivo:"
				           GridPane.rowIndex="2"
				           GridPane.columnIndex="0"/>
				
				    <TextField fx:id="motivo"
				               promptText="Ej.: recepción, clasificación, preparación..."
				               GridPane.rowIndex="2"
				               GridPane.columnIndex="1"
				               GridPane.columnSpan="2"/>
				
				
				    <!-- Registrar -->
				    <Button text="Registrar movimiento"
				            onAction="#moverPaquete"
				            styleClass="primary-button"
				            GridPane.rowIndex="3"
				            GridPane.columnIndex="1"/>
				
				</GridPane>
            </TitledPane>

        </VBox>
    </center>

</BorderPane>