<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@style.css" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="JavaApp.delta.AdminController">
  <top>
    <VBox spacing="5" styleClass="header">
      <padding><Insets bottom="18" left="22" right="22" top="18" /></padding>
      <HBox alignment="CENTER_LEFT" spacing="15">
        <VBox HBox.hgrow="ALWAYS">
          <Label styleClass="header-title" text="GESTIÓN DE LOGÍSTICA DELTA" />
          <HBox spacing="15"><Label fx:id="bienvenida" styleClass="header-subtitle" /><Label fx:id="etiquetaRol" styleClass="header-subtitle" /></HBox>
        </VBox>
        <Button onAction="#irPaquetes" styleClass="secondary-button" text="Ver paquetes" />
        <Button onAction="#cerrarSesion" styleClass="secondary-button" text="Cerrar sesión" />
      </HBox>
    </VBox>
  </top>
  <center>
    <VBox spacing="12">
      <padding><Insets bottom="18" left="18" right="18" top="18" /></padding>
      <TableView fx:id="tabla" prefHeight="200" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="ColumnaId" prefWidth="55" text="ID" />
          <TableColumn fx:id="ColumnaUsuario" prefWidth="170" text="Usuario" />
          <TableColumn fx:id="ColumnaRol" prefWidth="150" text="Rol" />
          <TableColumn fx:id="ColumnaNombre" prefWidth="130" text="Nombre" />
          <TableColumn fx:id="ColumnaApellido" prefWidth="130" text="Apellido" />
        </columns>
      </TableView>
      <TitledPane fx:id="panelOperaciones" expanded="true" text="Cambiar rol de usuario">
        <VBox spacing="8">
          <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
          <GridPane hgap="8" vgap="8">
            <Label text="Usuario:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="CambiarUsuario" prefWidth="260" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="Nuevo rol:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <ComboBox fx:id="CambiarRol" prefWidth="220" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
            <Label text="Licencia (si es chofer):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="RolLicencia" promptText="N.º de licencia" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Categoría:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <TextField fx:id="RolCategoriaLicencia" promptText="Ej. B1" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
            <Label text="Vencimiento:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="RolVencimientoLicencia" promptText="AAAA-MM-DD" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Button onAction="#modificarRol" styleClass="primary-button" text="Guardar rol" GridPane.rowIndex="2" GridPane.columnIndex="3"/>
            <Label fx:id="rolMensaje" wrapText="true" GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="3"/>
          </GridPane>
        </VBox>
      </TitledPane>
      <TitledPane fx:id="panelUsuario" expanded="true" text="Crear usuario">
        <GridPane hgap="8" vgap="8">
          <padding><Insets bottom="10" left="10" right="10" top="10" /></padding>
          <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
          <TextField fx:id="UsuarioNombre" promptText="Nombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
          <Label text="Apellido:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
          <TextField fx:id="UsuarioApellido" promptText="Apellido" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
          <Label text="DNI:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
          <TextField fx:id="UsuarioDni" promptText="7 u 8 dígitos" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
          <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
          <TextField fx:id="UsuarioEmail" promptText="correo@ejemplo.com" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
          <Label text="Nombre de usuario:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
          <TextField fx:id="UsuarioNombreUsuarioField" promptText="Usuario para iniciar sesión" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
          <Label text="Contraseña:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
          <PasswordField fx:id="UsuarioContrasena" promptText="Mínimo 6 caracteres" GridPane.rowIndex="2" GridPane.columnIndex="3"/>
          <Label text="Rol:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
          <ComboBox fx:id="UsuarioRol" prefWidth="220" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
          <Label text="Licencia (si es chofer):" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
          <TextField fx:id="UsuarioLicencia" promptText="N.º de licencia" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
          <Label text="Categoría:" GridPane.rowIndex="4" GridPane.columnIndex="2"/>
          <TextField fx:id="UsuarioCategoriaLicencia" promptText="Ej. B1" GridPane.rowIndex="4" GridPane.columnIndex="3"/>
          <Label text="Vencimiento:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
          <TextField fx:id="UsuarioVencimientoLicencia" promptText="AAAA-MM-DD" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
          <Button fx:id="Registrar" onAction="#registrar" styleClass="primary-button" text="Crear usuario" GridPane.rowIndex="5" GridPane.columnIndex="3"/>
          <Label fx:id="mensaje" wrapText="true" GridPane.rowIndex="6" GridPane.columnIndex="1" GridPane.columnSpan="3"/>
          <columnConstraints><ColumnConstraints minWidth="100"/><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints minWidth="100"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
        </GridPane>
      </TitledPane>
      <TitledPane fx:id="panelAdministracion" expanded="false" text="Resumen administrativo">
        <HBox spacing="15"><padding><Insets bottom="12" left="12" right="12" top="12" /></padding><Label fx:id="resumen" text="Resumen administrativo"/></HBox>
      </TitledPane>
    </VBox>
  </center>
</BorderPane>
